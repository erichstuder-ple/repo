{
    "name": "devcontainer",
    "dockerFile": "Dockerfile",

    // port for platformio home server
    "forwardPorts": [8008],

    "customizations": {
        "vscode": {
            "extensions": [
                "ybaumes.highlight-trailing-white-spaces",
                "platformio.platformio-ide"
            ],
            "settings": {
                "platformio-ide.pioHomeServerHttpPort": 8008,
                "platformio-ide.useBuiltinPIOCore": false
            }
        }
    }
}
